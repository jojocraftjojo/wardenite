# Kopieren nach .env und ausfuellen. Niemals echte Secrets committen.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
# Muss exakt der Redirect-URI im Discord Developer Portal entsprechen
DASHBOARD_BASE_URL=https://dashboard.example.com
DATABASE_URL=sqlite://wardenite.db
BIND_ADDR=127.0.0.1:8080
# Zufaelliger String, mindestens 32 Zeichen
SESSION_SECRET=
